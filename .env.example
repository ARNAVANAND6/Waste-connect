# Waste Connect — Environment Variables
# Copy this to .env and fill in your values

# ── Anthropic API (REQUIRED for AI detection) ────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wasteconnect

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── ML Service ───────────────────────────────────────────────────────────────
YOLO_MODEL_PATH=./ml-service/model/yolo11_waste.pt

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
VITE_ML_URL=http://localhost:8000
